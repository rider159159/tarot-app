# Reverse proxy for the production stack — behind Cloudflare (orange-cloud proxy).
# TLS terminates here with a Cloudflare Origin Certificate (CF↔origin leg).
# Public TLS (visitor↔CF) is handled by Cloudflare. SSL mode: Full (strict).
#
# Naked-IP access (http://134.185.107.141) is intentionally NOT served:
# only the domain vhost is defined, so direct-to-origin IP hits get no match.
tarot.rydercloud.cc {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	# API → ASP.NET Core backend. Caddy sets X-Forwarded-For for the rate limiter.
	handle /api/* {
		reverse_proxy backend:5098
	}

	# Everything else → SvelteKit SSR (Node adapter).
	handle {
		reverse_proxy frontend:3000
	}
}
