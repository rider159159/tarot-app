PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_CONNECTION_STRING=

# Server-side API URL (SvelteKit server → .NET backend, not exposed to browser)
# Dev (Docker): http://backend:5098
# Dev (local):  http://localhost:5098
# Prod (OCI self-host): http://backend:5098 (same Docker network)
INTERNAL_API_URL=http://backend:5098

# Public origin the frontend is served from (SvelteKit Node adapter ORIGIN).
# Required in prod behind a reverse proxy so CSRF accepts proxied form POSTs.
# Prod (OCI self-host): https://tarot.rydercloud.cc  — leave unset for local dev.
# ORIGIN=https://tarot.rydercloud.cc

# Backend CORS allowed origins (comma-separated, no trailing slash)
# Prod (OCI self-host): https://tarot.rydercloud.cc
ALLOWED_ORIGINS=http://localhost:5173

# Admin allowlist for /api/admin/* endpoints (comma-separated Supabase user IDs).
# A user ID is the JWT `sub` claim / auth.users.id. Empty = no admins.
ADMIN_USER_IDS=

# ─── Test account (for local dev / API smoke tests) ──────────────────────────
# Pre-created in Supabase. email_confirmed_at 已設好，可直接 password grant 換 token。
# 取得 access_token：
#   curl -X POST "$PUBLIC_SUPABASE_URL/auth/v1/token?grant_type=password" \
#     -H "apikey: $PUBLIC_SUPABASE_ANON_KEY" \
#     -H "Content-Type: application/json" \
#     -d "{\"email\":\"$TEST_USER_EMAIL\",\"password\":\"$TEST_USER_PASSWORD\"}"
TEST_USER_EMAIL=rider159159+tarot-test@gmail.com
TEST_USER_PASSWORD=
